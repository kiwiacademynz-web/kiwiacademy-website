{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/uk-nz-au",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
